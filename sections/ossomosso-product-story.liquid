{% liquid
  assign featured_image = product.featured_image
%}

<section class="osso-product-story color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" data-product-handle="{{ product.handle }}" style="--story-image-radius: {{ section.settings.image_radius }}px;">
  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'intro' %}

          {% assign intro_eyebrow = block.settings.eyebrow %}
          {% assign intro_title = block.settings.title %}
          {% assign intro_body = block.settings.body %}

        <div class="osso-product-story__intro" {{ block.shopify_attributes }}>
          <div class="osso-product-story__intro-copy">
            {% if intro_eyebrow != blank %}<p class="osso-product-story__eyebrow">{{ intro_eyebrow }}</p>{% endif %}
            {% if intro_title != blank %}<h2 class="osso-product-story__title">{{ intro_title }}</h2>{% endif %}
            {% if intro_body != blank %}<div class="osso-product-story__text rte">{{ intro_body }}</div>{% endif %}
          </div>
          {% if block.settings.show_specs %}
            <div class="osso-product-story__specs">
              {% for i in (1..4) %}

                  {% assign spec_label_key = 'spec_' | append: i | append: '_label' %}
                  {% assign spec_value_key = 'spec_' | append: i | append: '_value' %}
                  {% assign spec_label = block.settings[spec_label_key] %}
                  {% assign spec_value = block.settings[spec_value_key] %}

                {% if spec_label != blank or spec_value != blank %}
                  <div class="osso-product-story__spec">
                    {% if spec_label != blank %}<span class="osso-product-story__spec-label">{{ spec_label }}</span>{% endif %}
                    {% if spec_value != blank %}<span class="osso-product-story__spec-value">{{ spec_value }}</span>{% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>

      {% when 'features' %}
        <div class="osso-product-story__features" {{ block.shopify_attributes }}>
          {% for i in (1..4) %}

              {% assign feature_title_key = 'feature_' | append: i | append: '_title' %}
              {% assign feature_text_key = 'feature_' | append: i | append: '_text' %}
              {% assign feature_title = block.settings[feature_title_key] %}
              {% assign feature_text = block.settings[feature_text_key] %}

            {% if feature_title != blank or feature_text != blank %}
              <article class="osso-product-story__feature">
                {% if feature_title != blank %}<h3 class="osso-product-story__feature-title">{{ feature_title }}</h3>{% endif %}
                {% if feature_text != blank %}<p class="osso-product-story__feature-copy">{{ feature_text }}</p>{% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>

      {% when 'media_grid' %}
        <div class="osso-product-story__grid" {{ block.shopify_attributes }}>
          {% for i in (1..4) %}
            {% assign type_key = 'card_' | append: i | append: '_type' %}
            {% assign card_type = block.settings[type_key] %}
            {% if card_type == blank %}
              {% assign card_type = 'image' %}
            {% endif %}
            {% if card_type == 'image' %}
              {% assign card_media = product.media[forloop.index0].preview_image | default: featured_image %}
              <article class="osso-product-story__card osso-product-story__card--image">
                {% if card_media != blank %}
                  {{ card_media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400', class: 'osso-product-story__image', alt: product.title }}
                {% endif %}
              </article>
            {% else %}

                {% assign kicker_key = 'card_' | append: i | append: '_kicker' %}
                {% assign title_key = 'card_' | append: i | append: '_title' %}
                {% assign text_key = 'card_' | append: i | append: '_text' %}
                {% assign card_kicker = block.settings[kicker_key] %}
                {% assign card_title = block.settings[title_key] %}
                {% assign card_text = block.settings[text_key] %}

              {% assign dark_key = 'card_' | append: i | append: '_dark' %}
              <article class="osso-product-story__card osso-product-story__card--text{% if block.settings[dark_key] %} osso-product-story__card--dark{% endif %}">
                {% if card_kicker != blank %}<p class="osso-product-story__card-kicker">{{ card_kicker }}</p>{% endif %}
                {% if card_title != blank %}<h3 class="osso-product-story__card-title">{{ card_title }}</h3>{% endif %}
                {% if card_text != blank %}<p class="osso-product-story__card-copy">{{ card_text }}</p>{% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>

      {% when 'highlight' %}

          {% assign highlight_eyebrow = block.settings.eyebrow %}
          {% assign highlight_title = block.settings.title %}
          {% assign highlight_text = block.settings.text %}

        <div class="osso-product-story__highlight{% if block.settings.media_position == 'right' %} osso-product-story__row--image-right{% endif %}" {{ block.shopify_attributes }}>
          <div class="osso-product-story__highlight-media" style="--story-image-scale: {{ block.settings.image_zoom | default: 100 | divided_by: 100.0 }};">
            {% assign highlight_media = block.settings.media | default: product.media[2].preview_image | default: featured_image %}
            {% if highlight_media != blank %}{{ highlight_media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400', class: 'osso-product-story__image', alt: product.title }}{% endif %}
          </div>
          <div class="osso-product-story__highlight-copy">
            {% if highlight_eyebrow != blank %}<p class="osso-product-story__eyebrow">{{ highlight_eyebrow }}</p>{% endif %}
            {% if highlight_title != blank %}<h3 class="osso-product-story__highlight-title">{{ highlight_title }}</h3>{% endif %}
            {% if highlight_text != blank %}<p class="osso-product-story__card-copy">{{ highlight_text }}</p>{% endif %}
          </div>
        </div>

      {% when 'details' %}

          {% assign details_eyebrow = block.settings.eyebrow %}
          {% assign details_title = block.settings.title %}
          {% assign details_text = block.settings.text %}

        <div class="osso-product-story__details{% if block.settings.media_position == 'right' %} osso-product-story__row--image-right{% endif %}" {{ block.shopify_attributes }}>
          <div class="osso-product-story__details-visual" style="--story-image-fit: {{ block.settings.image_fit | default: 'cover' }}; --story-image-background: {{ block.settings.image_background | default: '#efefef' }};">
            {% assign details_media = block.settings.image | default: product.media[1].preview_image | default: featured_image %}
            {% if details_media != blank %}{{ details_media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1400', class: 'osso-product-story__details-image', alt: product.title }}{% endif %}
          </div>
          <div class="osso-product-story__details-copy">
            {% if details_eyebrow != blank %}<p class="osso-product-story__eyebrow">{{ details_eyebrow }}</p>{% endif %}
            {% if details_title != blank %}<h2 class="osso-product-story__section-title">{{ details_title }}</h2>{% endif %}
            {% if details_text != blank %}<div class="osso-product-story__text rte">{{ details_text }}</div>{% endif %}
            {% if block.settings.show_accordion %}
              <div class="osso-product-story__accordion">
                {% for i in (1..3) %}

                    {% assign heading_key = 'accordion_' | append: i | append: '_heading' %}
                    {% assign content_key = 'accordion_' | append: i | append: '_content' %}
                    {% assign acc_heading = block.settings[heading_key] %}
                    {% assign acc_content = block.settings[content_key] %}

                  {% if acc_heading != blank %}
                    <details class="osso-product-story__accordion-item">
                      <summary>{{ acc_heading }}</summary>
                      {% if acc_content != blank %}<div class="osso-product-story__accordion-body rte">{{ acc_content }}</div>{% endif %}
                    </details>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>

      {% when 'tech_specs' %}

          {% assign tech_label = block.settings.label %}
          {% assign tech_title = block.settings.title %}

        <div class="osso-product-story__tech" {{ block.shopify_attributes }}>
          <div class="osso-product-story__tech-inner">
            <div class="osso-product-story__tech-header">
              {% if tech_label != blank %}<p class="osso-product-story__eyebrow">{{ tech_label }}</p>{% endif %}
              {% if tech_title != blank %}<h2 class="osso-product-story__section-title">{{ tech_title }}</h2>{% endif %}
            </div>
            <dl class="osso-product-story__tech-grid">
              {% assign spec_order = '7,8,1,2,3,4,5,6' | split: ',' %}
              {% for i in spec_order %}

                  {% assign value_key = 'spec_' | append: i | append: '_value' %}
                  {% assign label_key = 'spec_' | append: i | append: '_label' %}
                  {% assign spec_value = block.settings[value_key] %}
                  {% assign spec_label = block.settings[label_key] %}

                {% if spec_value != blank or spec_label != blank %}
                  <div class="osso-product-story__tech-item">
                    {% if spec_label != blank %}<dt class="osso-product-story__tech-label">{{ spec_label }}</dt>{% endif %}
                    {% if spec_value != blank %}<dd class="osso-product-story__tech-value">{{ spec_value }}</dd>{% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </dl>
          </div>
        </div>

      {% when 'reviews' %}

          {% assign reviews_label = block.settings.label %}
          {% assign reviews_title = block.settings.title %}
          {% assign rating_text = block.settings.rating_text %}

        <div class="osso-product-story__reviews" {{ block.shopify_attributes }}>
          <div class="osso-product-story__reviews-header">
            <div>
              {% if reviews_label != blank %}<p class="osso-product-story__eyebrow">{{ reviews_label }}</p>{% endif %}
              {% if reviews_title != blank %}<h2 class="osso-product-story__section-title">{{ reviews_title }}</h2>{% endif %}
            </div>
            {% if rating_text != blank %}<div class="osso-product-story__reviews-summary">{{ rating_text }}</div>{% endif %}
          </div>
          <div class="osso-product-story__reviews-grid">
            {% for i in (1..3) %}
                {% assign text_key = 'review_' | append: i | append: '_text' %}
                {% assign author_key = 'review_' | append: i | append: '_author' %}
                {% assign review_text = block.settings[text_key] %}
                {% assign review_author = block.settings[author_key] %}

              {% if review_text != blank %}
                <article class="osso-product-story__review">
                  {% liquid
                    assign note_icon_key = 'note_' | append: i | append: '_icon'
                    assign note_icon = block.settings[note_icon_key]
                    if note_icon == blank
                      case i
                        when 1
                          assign note_icon = 'map_pin'
                        when 2
                          assign note_icon = 'plant'
                        when 3
                          assign note_icon = 'check_box'
                      endcase
                    endif
                  %}
                  <svg class="osso-product-story__note-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">{% render 'icon', icon: note_icon %}</svg>
                  {% if review_author != blank %}<h3 class="osso-product-story__review-author">{{ review_author }}</h3>{% endif %}
                  <p class="osso-product-story__review-text">{{ review_text }}</p>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
    {% endcase %}
  {% endfor %}
</section>

{% stylesheet %}
  .osso-product-story {
    --story-ink: #1f2521;
    --story-muted: #69736b;
    --story-line: rgb(31 37 33 / 16%);
    --story-paper: #f4f2ec;
    --story-accent: #7d967f;
    overflow: hidden;
    background: var(--story-paper);
    color: var(--story-ink);
  }


  .osso-product-story__intro,
  .osso-product-story__highlight,
  .osso-product-story__details,
  .osso-product-story__tech,
  .osso-product-story__reviews {
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 5vw, 6rem);
  }

  .osso-product-story__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, .75fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    max-width: 92rem;
    margin: 0 auto;
  }

  .osso-product-story__intro-copy { max-width: 48rem; }
  .osso-product-story__eyebrow,
  .osso-product-story__card-kicker,
  .osso-product-story__spec-label,
  .osso-product-story__tech-label {
    color: var(--story-muted);
    font-size: .7rem;
    letter-spacing: .13em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .osso-product-story__eyebrow { margin: 0 0 1rem; }
  .osso-product-story__eyebrow--light { color: rgb(255 255 255 / 70%); }
  .osso-product-story__title,
  .osso-product-story__highlight-title,
  .osso-product-story__card-title,
  .osso-product-story__section-title {
    margin: 0;
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: .98;
  }

  .osso-product-story__title { max-width: 11ch; font-size: clamp(3rem, 8vw, 8rem); }
  .osso-product-story__section-title { max-width: 15ch; font-size: clamp(2rem, 4.5vw, 4.5rem); }
  .osso-product-story__section-title--light { color: #fff; }
  .osso-product-story__text,
  .osso-product-story__card-copy,
  .osso-product-story__feature-copy,
  .osso-product-story__accordion-body,
  .osso-product-story__review-text {
    color: color-mix(in srgb, var(--story-ink) 74%, transparent);
    font-size: clamp(.95rem, 1.2vw, 1.12rem);
    line-height: 1.55;
  }

  .osso-product-story__text { max-width: 38rem; margin-top: 2rem; }
  .osso-product-story__text p,
  .osso-product-story__card-copy,
  .osso-product-story__highlight-copy p,
  .osso-product-story__details-copy p { margin: 0; }
  .osso-product-story__text p + p,
  .osso-product-story__details-copy p + p { margin-top: 1rem; }

  .osso-product-story__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--story-line);
    padding-top: 1rem;
  }

  .osso-product-story__spec { display: grid; gap: .35rem; }
  .osso-product-story__spec-label { color: var(--story-muted); }
  .osso-product-story__spec-value { font-size: .95rem; line-height: 1.35; }

  .osso-product-story__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border-block: 1px solid var(--story-line);
    background: var(--story-line);
  }

  .osso-product-story__feature { min-height: 15rem; padding: clamp(1.5rem, 3vw, 3rem); background: var(--story-paper); }
  .osso-product-story__feature-title { margin: 0 0 1rem; font-size: 1.45rem; font-weight: 400; letter-spacing: -.025em; }
  .osso-product-story__feature-copy { margin: 0; }

  .osso-product-story__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--story-line); }
  .osso-product-story__card { min-height: clamp(16rem, 30vw, 32rem); background: var(--story-paper); }
  .osso-product-story__card--image { overflow: hidden; }
  .osso-product-story__card--text { display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(1.5rem, 3vw, 3rem); }
  .osso-product-story__card--dark { background: var(--story-ink); color: #fff; }
  .osso-product-story__card--dark .osso-product-story__card-kicker,
  .osso-product-story__card--dark .osso-product-story__card-copy { color: rgb(255 255 255 / 70%); }
  .osso-product-story__card-title { max-width: 10ch; font-size: clamp(1.7rem, 3vw, 3rem); }
  .osso-product-story__image,
  .osso-product-story__details-image { display: block; width: 100%; height: 100%; object-fit: cover; }

  .osso-product-story__highlight,
  .osso-product-story__details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 6vw, 7rem); align-items: center; max-width: 92rem; margin: 0 auto; }
  .osso-product-story__highlight-media,
  .osso-product-story__details-visual { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--story-image-radius, 20px); background: color-mix(in srgb, var(--story-paper) 75%, var(--story-accent)); }
  .osso-product-story__highlight-media .osso-product-story__image { transform: scale(var(--story-image-scale, 1)); }
  .osso-product-story__details-visual { background: var(--story-image-background, #efefef); }
  .osso-product-story__details-image { object-fit: var(--story-image-fit, cover); }
  @media (min-width: 750px) {
    .osso-product-story__row--image-right > :first-child { grid-column: 2; grid-row: 1; }
    .osso-product-story__row--image-right > :last-child { grid-column: 1; grid-row: 1; }
  }
  .osso-product-story__highlight-copy { max-width: 34rem; }
  .osso-product-story__highlight-title { margin: 0 0 1.5rem; max-width: 16ch; font-size: clamp(2rem, 3.2vw, 3.4rem); line-height: 1.15; }

  .osso-product-story__details { border-top: 0; }
  .osso-product-story__details + .osso-product-story__highlight { padding-top: 0; }
  .osso-product-story__details-copy { max-width: 36rem; }
  .osso-product-story__accordion { margin-top: 2.5rem; border-top: 1px solid var(--story-line); }
  .osso-product-story__accordion-item { border-bottom: 1px solid var(--story-line); }
  .osso-product-story__accordion-item summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 0; cursor: pointer; list-style: none; font-size: 1.05rem; }
  .osso-product-story__accordion-item summary::-webkit-details-marker { display: none; }
  .osso-product-story__accordion-item summary::after { content: '+'; color: var(--story-muted); transition: transform .2s ease; }
  .osso-product-story__accordion-item[open] summary::after { transform: rotate(45deg); }
  .osso-product-story__accordion-body { padding: 0 0 1.15rem; }

  .osso-product-story__tech { background: #ebe8df; color: var(--story-ink); padding-block: clamp(2.5rem, 5vw, 5rem); }
  .osso-product-story__tech-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(2rem, 6vw, 6rem); max-width: 92rem; margin: 0 auto; }
  .osso-product-story__tech .osso-product-story__section-title,
  .osso-product-story__reviews .osso-product-story__section-title { max-width: 22ch; font-size: clamp(2rem, 3vw, 3rem); line-height: 1.08; }
  .osso-product-story__tech-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(1.5rem, 4vw, 4rem); margin: 0; }
  .osso-product-story__tech-item { display: flex; flex-direction: column; gap: .5rem; padding: 1rem 0; border-top: 1px solid var(--story-line); }
  .osso-product-story__tech-value { margin: 0; font-size: 1.125rem; line-height: 1.4; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .osso-product-story__tech-label { margin: 0; color: #565e57; font-size: .75rem; line-height: 1.5; letter-spacing: .08em; }

  .osso-product-story__reviews { max-width: 92rem; margin: 0 auto; }
  .osso-product-story__reviews-header { display: flex; justify-content: space-between; gap: 2rem; align-items: end; padding-bottom: 2.5rem; }
  .osso-product-story__reviews-summary { color: var(--story-muted); font-size: .85rem; letter-spacing: .06em; }
  .osso-product-story__reviews-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 4rem); }
  .osso-product-story__review { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); column-gap: 1rem; align-content: start; align-items: start; padding-top: 1.5rem; border-top: 1px solid var(--story-line); }
  .osso-product-story__note-icon { display: block; width: 1.6rem; height: 1.6rem; color: var(--story-ink); }
  .osso-product-story__review-text { grid-column: 2; }
  .osso-product-story__review-text { margin: 0; }
  .osso-product-story__review-author { margin: 0 0 .75rem; color: var(--story-ink); font-family: var(--font-body--family); font-size: 1.15rem; font-weight: 500; letter-spacing: -.02em; line-height: 1.4; }


  @media (max-width: 749px) {
    .osso-product-story__intro,
    .osso-product-story__highlight,
    .osso-product-story__details { grid-template-columns: 1fr; }
    .osso-product-story__title { max-width: 12ch; font-size: clamp(3rem, 17vw, 6rem); }
    .osso-product-story__features,
    .osso-product-story__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .osso-product-story__tech-inner { grid-template-columns: 1fr; }
    .osso-product-story__reviews-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .osso-product-story__reviews-header { display: block; }
    .osso-product-story__reviews-summary { margin-top: 1.25rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossomosso - Product Story",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro + Specs",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Sculptural light"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A design brought to life."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text",
          "default": "<p>A piece designed to live naturally in your space, bring presence and accompany everyday moments without overwhelming them.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_specs",
          "label": "Show specs grid",
          "default": true
        },
        {
          "type": "header",
          "content": "Specs"
        },
        {
          "type": "text",
          "id": "spec_1_label",
          "label": "Spec 1 label",
          "default": "Colour"
        },
        {
          "type": "text",
          "id": "spec_1_value",
          "label": "Spec 1 value",
          "default": "Natural sand"
        },
        {
          "type": "text",
          "id": "spec_2_label",
          "label": "Spec 2 label",
          "default": "Production"
        },
        {
          "type": "text",
          "id": "spec_2_value",
          "label": "Spec 2 value",
          "default": "Bajo pedido"
        },
        {
          "type": "text",
          "id": "spec_3_label",
          "label": "Spec 3 label",
          "default": "Origin"
        },
        {
          "type": "text",
          "id": "spec_3_value",
          "label": "Spec 3 value",
          "default": "Made in Madrid"
        },
        {
          "type": "text",
          "id": "spec_4_label",
          "label": "Spec 4 label",
          "default": "Character"
        },
        {
          "type": "text",
          "id": "spec_4_value",
          "label": "Spec 4 value",
          "default": "Soft, enveloping light"
        }
      ]
