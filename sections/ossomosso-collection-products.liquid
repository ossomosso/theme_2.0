{% liquid
  assign selected_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
%}

{% if selected_collection != blank %}
  <section class="ossomosso-collection-products" {{ section.shopify_attributes }}>
    <div class="ossomosso-collection-products__inner">
      <h2 class="ossomosso-collection-products__title">
        {{ section.settings.heading | default: selected_collection.title | escape }}
      </h2>
      <ul class="ossomosso-collection-products__grid" role="list">
        {% for product in selected_collection.products limit: product_limit %}
          {% for variant in product.variants %}
            {% assign card_media = variant.featured_media | default: product.featured_media %}
            <li class="ossomosso-collection-products__card">
              <a href="{{ variant.url }}" class="ossomosso-collection-products__link">
                {% if card_media %}
                  {{ card_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', alt: product.title }}
                {% endif %}
                <h3>{{ product.title | escape }}</h3>
                {% unless variant.title == 'Default Title' %}
                  <p class="ossomosso-collection-products__variants">{{ variant.title | escape }}</p>
                {% endunless %}
                <p>{{ variant.price | money }}</p>
              </a>
            </li>
          {% endfor %}
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .ossomosso-collection-products { padding: 0 0 48px; }
  .ossomosso-collection-products__inner { margin: 0 auto; max-width: var(--page-width); padding: 0 var(--page-margin); }
  .ossomosso-collection-products__title { margin: 0 0 20px; }
  .ossomosso-collection-products__grid { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .ossomosso-collection-products__link { color: inherit; display: block; text-decoration: none; }
  .ossomosso-collection-products__link img { aspect-ratio: 3 / 4; display: block; height: auto; object-fit: cover; width: 100%; }
  .ossomosso-collection-products__link h3, .ossomosso-collection-products__link p { margin: 8px 0 0; }
  .ossomosso-collection-products__link h3 { font-size: 0.75rem; font-weight: 500; line-height: 1.2; }
  .ossomosso-collection-products__variants { font-size: 0.875rem; opacity: 0.75; }
  @media screen and (min-width: 750px) { .ossomosso-collection-products__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossomosso collections",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 1, "max": 50, "step": 1, "default": 12 }
  ],
  "presets": [{ "name": "Ossomosso collections" }]
}
{% endschema %}
