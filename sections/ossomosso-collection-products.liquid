{% liquid
  assign selected_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
  assign show_group = true
  if collection.handle != 'all'
    assign selected_collection = collection
    if section.settings.all_products_only
      assign show_group = false
    endif
  endif
%}

{% if selected_collection != blank and show_group %}
  <section class="ossomosso-collection-products" {{ section.shopify_attributes }}>
    <div class="ossomosso-collection-products__inner">
      {% if collection.handle == 'all' %}
      <h2 class="ossomosso-collection-products__title">
        {{ section.settings.heading | default: selected_collection.title | escape }}
      </h2>
      {% endif %}
      <ul class="ossomosso-collection-products__grid" data-ossomosso-variant-grid role="list">
        {% for product in selected_collection.products limit: product_limit %}
          {% for variant in product.variants %}
            {% assign card_media = variant.featured_media | default: product.featured_media %}
            {% assign color_value = blank %}
            {% for option in product.options_with_values %}
              {% assign option_name = option.name | downcase %}
              {% if option_name == 'color' or option_name == 'colour' or option_name == 'colorway' %}
                {% assign color_value = variant.options[forloop.index0] | downcase %}
              {% endif %}
            {% endfor %}
            {% assign color_tag = '[color:' | append: color_value | append: ']' %}
            <li class="ossomosso-collection-products__card" data-product-handle="{{ product.handle }}">
              <a href="{{ variant.url }}" class="ossomosso-collection-products__link">
                <div class="ossomosso-collection-products__gallery">
                  {% if card_media %}
                    {{ card_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', alt: product.title }}
                  {% endif %}
                </div>
                <h3>{{ product.title | escape }}</h3>
                {% unless variant.title == 'Default Title' %}
                  <p class="ossomosso-collection-products__variants">{% render 'ossomosso-color-name', value: variant.title %}</p>
                {% endunless %}
                <p>{{ variant.price | money }}</p>
              </a>
            </li>
          {% endfor %}
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% javascript %}
  document.querySelectorAll('[data-ossomosso-variant-grid]').forEach((grid) => {
    const groups = new Map();
    [...grid.children].forEach((card) => {
      const handle = card.dataset.productHandle;
      groups.set(handle, [...(groups.get(handle) || []), card]);
    });

    const random = (items) => items.sort(() => Math.random() - 0.5);
    groups.forEach(random);

    let previousHandle;
    while ([...groups.values()].some((cards) => cards.length)) {
      const available = random([...groups.entries()].filter(([handle, cards]) => cards.length && handle !== previousHandle));
      const fallback = [...groups.entries()].filter(([, cards]) => cards.length);
      const [handle, cards] = available[0] || fallback[0];
      grid.append(cards.pop());
      previousHandle = handle;
    }
  });
{% endjavascript %}

{% stylesheet %}
  .ossomosso-collection-products { padding: 0 0 48px; }
  .ossomosso-collection-products__inner { margin: 0 auto; max-width: var(--page-width); padding: 0 var(--page-margin); }
  .ossomosso-collection-products__title { margin: 0 0 20px; }
  .ossomosso-collection-products__grid { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .ossomosso-collection-products__link { color: inherit; display: block; text-decoration: none; }
  .ossomosso-collection-products__gallery { overflow: hidden; }
  .ossomosso-collection-products__gallery img { aspect-ratio: 3 / 4; display: block; height: auto; object-fit: cover; width: 100%; }
  .ossomosso-collection-products__link h3, .ossomosso-collection-products__link p { margin: 8px 0 0; }
  .ossomosso-collection-products__link h3 { font-size: 1.2rem; font-weight: 500; line-height: 1.2; }
  .ossomosso-collection-products__variants { font-size: 0.875rem; opacity: 0.75; }
  @media screen and (min-width: 750px) { .ossomosso-collection-products__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossomosso collections",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "all_products_only", "label": "Show only in All products", "default": false },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 1, "max": 50, "step": 1, "default": 12 }
  ],
  "presets": [{ "name": "Ossomosso collections" }]
}
{% endschema %}
