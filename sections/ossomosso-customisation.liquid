{{ 'ossomosso-customisation.css' | asset_url | stylesheet_tag }}

<section class="osso-custom" aria-labelledby="CustomTitle-{{ section.id }}">
  <header class="osso-custom__header">
    <p class="osso-custom__eyebrow">{{ 'ossomosso_custom.eyebrow' | t }}</p>
    <h1 id="CustomTitle-{{ section.id }}">{{ 'ossomosso_custom.title' | t }} <em>{{ 'ossomosso_custom.emphasis' | t }}</em></h1>
    <p>{{ 'ossomosso_custom.intro' | t }}</p>
    <a class="osso-custom__text-link" href="#project-{{ section.id }}">{{ 'ossomosso_custom.shared_cta' | t }} <span aria-hidden="true">↗</span></a>
  </header>

  <div class="osso-custom__gallery">
    {% assign private_alt = 'ossomosso_custom.private_alt' | t %}
    {% assign corporate_alt = 'ossomosso_custom.corporate_alt' | t %}
    {% if section.settings.private_image != blank %}{{ section.settings.private_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'eager', alt: private_alt }}{% endif %}
    {% if section.settings.corporate_image != blank %}{{ section.settings.corporate_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'eager', alt: corporate_alt }}{% endif %}
  </div>

  <section id="project-{{ section.id }}" class="osso-custom__project" aria-labelledby="ProjectTitle-{{ section.id }}">
    <div class="osso-custom__story">
      <p class="osso-custom__eyebrow">{{ 'ossomosso_custom.shared_label' | t }}</p>
      <h2 id="ProjectTitle-{{ section.id }}">{{ 'ossomosso_custom.shared_title' | t }}</h2>
      <p class="osso-custom__lead">{{ 'ossomosso_custom.shared_intro' | t }}</p>
      <ul class="osso-custom__features">
        {% for i in (1..3) %}{% assign key = 'ossomosso_custom.shared_feature_' | append: i %}<li><span aria-hidden="true">{{ i | prepend: '0' }}</span>{{ key | t }}</li>{% endfor %}
      </ul>
      <p class="osso-custom__note">{{ 'ossomosso_custom.private_note' | t }}</p>
      <p class="osso-custom__signature">{{ 'ossomosso_custom.signature' | t }}</p>
    </div>
    {% render 'ossomosso-project-form', section_id: section.id %}
  </section>

  <section class="osso-custom__process" aria-labelledby="ProcessTitle-{{ section.id }}">
    <p class="osso-custom__eyebrow">{{ 'ossomosso_custom.process_label' | t }}</p>
    <h2 id="ProcessTitle-{{ section.id }}">{{ 'ossomosso_custom.process_title' | t }}</h2>
    <ol>
      {% for i in (1..3) %}
        {% assign title_key = 'ossomosso_custom.step_' | append: i | append: '_title' %}
        {% assign body_key = 'ossomosso_custom.step_' | append: i | append: '_body' %}
        <li><span aria-hidden="true">{{ i | prepend: '0' }}</span><h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p></li>
      {% endfor %}
    </ol>
  </section>

  <div class="osso-custom__faq">
    <h2>{{ 'ossomosso_custom.faq_title' | t }}</h2>
    <div>{% for i in (1..3) %}{% assign question = 'ossomosso_custom.faq_' | append: i | append: '_q' %}{% assign answer = 'ossomosso_custom.faq_' | append: i | append: '_a' %}<details><summary>{{ question | t }}<span aria-hidden="true">+</span></summary><p>{{ answer | t }}</p></details>{% endfor %}</div>
  </div>
  <p class="osso-custom__email">{{ 'ossomosso_custom.email_prompt' | t }} <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></p>
</section>

{% schema %}
{
  "name": "Ossomosso - Customisation",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "image_picker", "id": "private_image", "label": "Lifestyle photo"},
    {"type": "image_picker", "id": "corporate_image", "label": "Detail photo"},
    {"type": "text", "id": "email", "label": "Contact email", "default": "info@ossomosso.com"}
  ],
  "presets": [{"name": "Ossomosso - Customisation"}]
}
{% endschema %}
