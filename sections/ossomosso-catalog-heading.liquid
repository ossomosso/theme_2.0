<section class="ossomosso-catalog-heading" {{ section.shopify_attributes }}>
  <h1>{% if collection.handle == 'all' %}{{ section.settings.heading | escape }}{% else %}{{ collection.title | escape }}{% endif %}</h1>
  {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
</section>

{% stylesheet %}
  .ossomosso-catalog-heading { margin: 0 auto; max-width: var(--page-width); padding: 32px var(--page-margin) 40px; }
  .ossomosso-catalog-heading h1 { margin: 0; }
  .ossomosso-catalog-heading .rte { margin-top: 16px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossomosso catalog heading",
  "settings": [
    { "type": "text", "id": "heading", "label": "All products heading", "default": "Products" }
  ],
  "presets": [{ "name": "Ossomosso catalog heading" }]
}
{% endschema %}
