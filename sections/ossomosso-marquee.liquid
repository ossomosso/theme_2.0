{% liquid
  assign items = section.settings.marquee_items | newline_to_br | split: '<br />'
%}
{% if section.settings.marquee_items != blank %}
<div class="osso-marquee" style="--marquee-background: {{ section.settings.background_color | default: 'var(--color-foreground)' }}; --marquee-text: {{ section.settings.text_color | default: 'var(--color-background)' }}; --marquee-dot: {{ section.settings.dot_color | default: 'var(--color-primary)' }}; --marquee-duration: {{ section.settings.speed }}s;" data-section-id="{{ section.id }}">
  <span class="visually-hidden">{{ section.settings.marquee_items | escape | newline_to_br }}</span>
  <div class="osso-marquee__track" aria-hidden="true">
    {% for copy in (1..2) %}
      <div class="osso-marquee__group">
        {% for item in items %}
          {% assign trimmed = item | strip %}
          {% if trimmed != blank %}
            <span class="osso-marquee__item">{{ trimmed | escape }}</span><span class="osso-marquee__dot">·</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}
{% stylesheet %}
  .osso-marquee { background: var(--marquee-background); color: var(--marquee-text); padding: 16px 0; overflow: hidden; width: 100%; max-width: 100%; position: relative; grid-column: 1 / -1; }
  .osso-marquee__track { display: flex; width: max-content; animation: osso-marquee-scroll var(--marquee-duration, 20s) linear infinite; }
  .osso-marquee__group { display: flex; align-items: center; flex-shrink: 0; min-width: 100vw; justify-content: space-around; }
  .osso-marquee__item { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; margin: 0 40px; opacity: .8; font-family: var(--font-body--family); font-weight: 400; white-space: nowrap; }
  .osso-marquee__dot { color: var(--marquee-dot); margin: 0 16px; }
  .osso-marquee:hover .osso-marquee__track { animation-play-state: paused; }
  @keyframes osso-marquee-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .osso-marquee__track { animation: none; width: 100%; }
    .osso-marquee__group { min-width: 0; width: 100%; flex-wrap: wrap; gap: 1rem; padding-inline: 1rem; }
    .osso-marquee__group + .osso-marquee__group { display: none; }
    .osso-marquee__item { margin: 0; white-space: normal; text-align: center; }
    .osso-marquee__dot { display: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Ossomosso - Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "marquee_items",
      "label": "Marquee items (one per line)",
      "default": "Diseño original\nPLA ecológico\nFabricación local\nPiezas únicas\nImpresión 3D\nMadrid, España\nBajo demanda\nPersonalizable"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Separator colour"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Loop duration",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Ossomosso - Marquee"
    }
  ]
}
{% endschema %}
