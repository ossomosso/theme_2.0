{%- liquid
  assign configured_product = section.settings.product
  assign selected_variant = configured_product.selected_or_first_available_variant
-%}

<section class="ossomosso-customizer color-{{ section.settings.color_scheme }}" data-ossomosso-customizer="{{ section.id }}">
  <div class="ossomosso-customizer__inner page-width">
    <header class="ossomosso-customizer__intro">
      <p class="ossomosso-customizer__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <div class="ossomosso-customizer__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </header>

    {%- if configured_product == blank -%}
      <p class="ossomosso-customizer__notice">Selecciona el producto base desde el editor del tema para activar el configurador.</p>
    {%- else -%}
      <div class="ossomosso-customizer__grid">
        <div class="ossomosso-customizer__preview" aria-live="polite">
          {%- if section.settings.fallback_image != blank -%}
            {{ section.settings.fallback_image | image_url: width: 1400 | image_tag: class: 'ossomosso-customizer__fallback', loading: 'eager', widths: '600, 900, 1200, 1400' }}
          {%- endif -%}
          <div class="ossomosso-customizer__layers" aria-label="Vista previa de tu lámpara"></div>
        </div>

        <div class="ossomosso-customizer__controls">
          <p class="ossomosso-customizer__product">{{ configured_product.title | escape }}</p>
          <p class="ossomosso-customizer__price">{{ selected_variant.price | money }}</p>

          <form method="post" action="{{ routes.cart_add_url }}" class="ossomosso-customizer__form" data-customizer-form>
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
            <div class="ossomosso-customizer__option-list" data-option-list></div>
            <button class="button ossomosso-customizer__submit" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
              {%- if selected_variant.available -%}Añadir al carrito{%- else -%}No disponible{%- endif -%}
            </button>
          </form>
        </div>
      </div>
    {%- endif -%}
  </div>

  <script type="application/json" data-customizer-options>
    [
      {%- for block in section.blocks -%}
        {
          "group": {{ block.settings.group | json }},
          "label": {{ block.settings.label | json }},
          "colour": {{ block.settings.colour | json }},
          "swatch": {{ block.settings.swatch | json }},
          "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

<script src="{{ 'personalizador-ossomosso.js' | asset_url }}" defer></script>

{% stylesheet %}
  .ossomosso-customizer { padding: clamp(32px, 6vw, 96px) 0; }
  .ossomosso-customizer__inner { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
  .ossomosso-customizer__intro { max-width: 720px; margin-bottom: clamp(28px, 5vw, 60px); }
  .ossomosso-customizer__eyebrow { margin: 0 0 8px; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }
  .ossomosso-customizer__intro h1 { margin: 0; }
  .ossomosso-customizer__description { margin-top: 16px; }
  .ossomosso-customizer__notice { padding: 24px; border: 1px dashed currentColor; }
  .ossomosso-customizer__grid { display: grid; gap: clamp(28px, 5vw, 72px); grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr); align-items: start; }
  .ossomosso-customizer__preview { position: sticky; top: 24px; aspect-ratio: 1 / 1; overflow: hidden; background: rgb(var(--color-foreground-rgb) / .04); }
  .ossomosso-customizer__fallback, .ossomosso-customizer__layers, .ossomosso-customizer__layers img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ossomosso-customizer__layers { pointer-events: none; }
  .ossomosso-customizer__layers img { transition: opacity .2s ease; }
  .ossomosso-customizer__product { margin: 0; font-size: 1.1rem; }
  .ossomosso-customizer__price { margin: 6px 0 24px; font-size: 1.3rem; }
  .ossomosso-customizer__option-list { display: grid; gap: 24px; margin-bottom: 28px; }
  .ossomosso-customizer__option { border-top: 1px solid rgb(var(--color-foreground-rgb) / .2); padding-top: 18px; }
  .ossomosso-customizer__option-heading { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .ossomosso-customizer__option-heading strong, .ossomosso-customizer__option-heading span { font-size: .92rem; }
  .ossomosso-customizer__option-heading span { opacity: .7; text-align: right; }
  .ossomosso-customizer__picker { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 10px; align-items: center; }
  .ossomosso-customizer__arrow { width: 44px; height: 44px; border: 1px solid currentColor; background: transparent; color: inherit; cursor: pointer; font-size: 1.4rem; }
  .ossomosso-customizer__current { display: flex; min-height: 44px; align-items: center; justify-content: center; gap: 10px; text-align: center; font-weight: 600; }
  .ossomosso-customizer__swatch { width: 18px; height: 18px; border: 1px solid rgb(0 0 0 / .2); border-radius: 50%; background: var(--swatch, transparent); }
  .ossomosso-customizer__submit { width: 100%; }
  @media screen and (max-width: 749px) {
    .ossomosso-customizer__grid { grid-template-columns: 1fr; }
    .ossomosso-customizer__preview { position: relative; top: auto; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Personalizador Ossomosso",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto base" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Diseña tu lámpara" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Personaliza tu pieza" },
    { "type": "richtext", "id": "description", "label": "Descripción", "default": "<p>Elige cada detalle y crea una combinación única.</p>" },
    { "type": "image_picker", "id": "fallback_image", "label": "Imagen de fondo opcional" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Opción de capa",
      "settings": [
        { "type": "select", "id": "group", "label": "Parte", "options": [
          { "value": "Parte superior", "label": "Parte superior" },
          { "value": "Parte inferior", "label": "Parte inferior" },
          { "value": "Base", "label": "Base" },
          { "value": "Bombilla", "label": "Bombilla" }
        ], "default": "Parte superior" },
        { "type": "text", "id": "label", "label": "Nombre de la opción", "default": "Blanco" },
        { "type": "text", "id": "colour", "label": "Color o acabado", "default": "Blanco" },
        { "type": "color", "id": "swatch", "label": "Muestra de color", "default": "#ffffff" },
        { "type": "image_picker", "id": "image", "label": "Render PNG/WebP con transparencia" }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [{ "name": "Personalizador Ossomosso" }]
}
{% endschema %}
