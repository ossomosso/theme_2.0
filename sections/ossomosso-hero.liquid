{% comment %}
  Ossomosso Hero Section
  Two-column layout: text left, image/visual right
{% endcomment %}

{% liquid
  assign eyebrow = section.settings.eyebrow
  assign title = section.settings.title
  assign title_emphasis = section.settings.title_emphasis
  assign body_text = section.settings.body_text
  assign primary_button_text = section.settings.primary_button_text
  assign primary_button_url = section.settings.primary_button_url
  assign image = section.settings.image
  assign caption = section.settings.caption
%}

<style>
  .osso-hero {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    align-items: center;
    gap: clamp(28px, 3.5vw, 56px);
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding: 32px 0 64px calc(var(--page-margin) + clamp(24px, 3.2vw, 48px));
    background: var(--color-background);
  }
  .osso-hero__left { min-width: 0; padding: 36px 0 28px clamp(0px, 2.5vw, 40px); }
  .osso-hero__eyebrow {
    margin: 0 0 28px;
    color: var(--color-primary);
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .osso-hero__title {
    margin: 0 0 28px;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(52px, 5.5vw, 84px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .osso-hero__title em { display: block; color: var(--color-primary); font-style: italic; }
  .osso-hero__body {
    max-width: 460px;
    margin: 0 0 34px;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    font-family: var(--font-body--family);
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 400;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .osso-hero__actions { display: flex; align-items: center; }
  .osso-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 56px;
    padding: 16px 28px;
    border: 0;
    border-radius: 99px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }
  .osso-hero__btn-primary:hover { background: var(--color-primary); color: var(--color-background); }
  .osso-hero__btn-primary:focus-visible { outline: 2px solid var(--color-foreground); outline-offset: 5px; }
  .osso-hero__btn-primary svg { width: 22px; height: 22px; flex-shrink: 0; }
  .osso-hero__scroll {
    margin: clamp(32px, 4vw, 60px) 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .osso-hero__right {
    position: relative;
    min-width: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 24px 0 0 24px;
    background: var(--color-background);
  }
  .osso-hero__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .osso-hero__caption {
    position: absolute;
    right: 20px;
    bottom: 20px;
    max-width: calc(100% - 40px);
    margin: 0;
    padding: 10px 16px;
    border-radius: 99px;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 12px;
    line-height: 1.4;
  }
  @media (max-width: 1100px) and (min-width: 901px) {
    .osso-hero__left { padding-left: 8px; }
    .osso-hero__title { font-size: 56px; }
  }
  @media (max-width: 900px) {
    .osso-hero { grid-template-columns: minmax(0, 1fr); gap: 30px; padding: 28px 0 48px; }
    .osso-hero__left { padding: 8px calc(var(--page-margin) + 24px) 0; }
    .osso-hero__title { max-width: 650px; font-size: clamp(44px, 7.5vw, 68px); }
    .osso-hero__right { aspect-ratio: 4 / 5; max-height: 720px; border-radius: 0; }
    .osso-hero__scroll { margin-top: 28px; }
  }
  @media (max-width: 599px) {
    .osso-hero { gap: 26px; padding: 20px 0 40px; }
    .osso-hero__left { padding-inline: calc(var(--page-margin) + 20px); }
    .osso-hero__eyebrow { margin-bottom: 20px; font-size: 10px; letter-spacing: 0.14em; }
    .osso-hero__title { margin-bottom: 22px; font-size: clamp(42px, 10vw, 58px); }
    .osso-hero__body { margin-bottom: 26px; font-size: 16px; }
    .osso-hero__btn-primary { min-height: 54px; gap: 24px; padding: 15px 24px; font-size: 13px; }
    .osso-hero__scroll { margin-top: 24px; font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) { .osso-hero__btn-primary { transition: none; } }
</style>

<section class="osso-hero" data-section-id="{{ section.id }}">
  <div class="osso-hero__left">
    {% if eyebrow != blank %}
      <p class="osso-hero__eyebrow">{{ eyebrow | escape }}</p>
    {% endif %}

    {% if title != blank %}
      <h1 class="osso-hero__title">
        {{ title | escape }}
        {% if title_emphasis != blank %}
          <em>{{ title_emphasis | escape }}</em>
        {% endif %}
      </h1>
    {% endif %}

    {% if body_text != blank %}
      <p class="osso-hero__body">{{ body_text | escape }}</p>
    {% endif %}

    <div class="osso-hero__actions">
      {% if primary_button_text != blank and primary_button_url != blank %}
        <a href="{{ primary_button_url }}" class="osso-hero__btn-primary"><span>{{ primary_button_text | escape }}</span><span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
      {% endif %}
    </div>

    {% if section.settings.scroll_text != blank %}<p class="osso-hero__scroll">{{ section.settings.scroll_text | escape }}</p>{% endif %}
  </div>

  <div class="osso-hero__right">
    {% if image != blank %}
      {{ image | image_url: width: 1600 | image_tag: class: 'osso-hero__image', loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1600', sizes: '(max-width: 900px) 100vw, 53vw', alt: section.settings.image_alt }}
    {% else %}
      <div class="osso-hero__placeholder" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--color-background); opacity: 0.5;">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if caption != blank %}
      <p class="osso-hero__caption">{{ caption }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Ossomosso - Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Impresión 3D · Diseño independiente · Madrid"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Objetos que hablan por sí solos."
    },
    {
      "type": "text",
      "id": "title_emphasis",
      "label": "Emphasis word (italic)",
      "default": "hablan"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Diseñamos y fabricamos piezas únicas en impresión 3D. Lámparas que transforman la luz, organizadores que transforman el espacio."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "Explorar colección"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "Lámpara Tulipa — Colección 001"
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll hint",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Ossomosso lamp"
    }
  ],
  "presets": [
    {
      "name": "Ossomosso - Hero"
    }
  ]
}
{% endschema %}
