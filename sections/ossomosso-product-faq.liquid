<div id="OssomossoProductFAQ" class="osso-product-faq" style="--faq-background: {{ section.settings.background_color }}; --faq-text: {{ section.settings.text_color }};" data-section-id="{{ section.id }}">
  <div class="osso-product-faq__layout">
    <div class="osso-product-faq__header">
      {% if section.settings.eyebrow != blank %}<p class="osso-product-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      <div class="osso-product-faq__intro rte">{{ section.settings.intro }}</div>
      {% if section.settings.contact_label != blank and section.settings.contact_url != blank %}
        <a href="{{ section.settings.contact_url }}" class="osso-product-faq__contact">{{ section.settings.contact_label | escape }}</a>
      {% endif %}
    </div>
    <div class="osso-product-faq__questions">
      {% for block in section.blocks %}
        {% if block.settings.question != blank and block.settings.answer != blank %}
          <details class="osso-product-faq__question" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question | escape }}</span><span class="osso-product-faq__toggle" aria-hidden="true">{{ 'icon-plus.svg' | inline_asset_content }}</span></summary>
            <div class="osso-product-faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
{% stylesheet %}
  .osso-product-faq { background: var(--faq-background); color: var(--faq-text); padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 5vw, 5rem); scroll-margin-top: 7rem; }
  .osso-product-faq__layout { max-width: 1440px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 7vw, 7rem); }
  .osso-product-faq__eyebrow { margin: 0 0 1rem; font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; }
  .osso-product-faq__header h2 { margin: 0 0 1.5rem; font-family: var(--font-heading--family); font-weight: var(--font-heading--weight); font-size: clamp(2.5rem, 5vw, 5rem); line-height: 1.05; }
  .osso-product-faq__intro { max-width: 34ch; font-size: .95rem; line-height: 1.7; }
  .osso-product-faq__contact { display: inline-block; margin-top: 1.5rem; text-decoration: underline; text-underline-offset: .3em; font-size: .85rem; }
  .osso-product-faq__question { border-bottom: 1px solid rgb(42 36 31 / .2); }
  .osso-product-faq__question:first-child { border-top: 1px solid rgb(42 36 31 / .2); }
  .osso-product-faq__question summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.35rem; min-height: 44px; list-style: none; cursor: pointer; font-size: .95rem; line-height: 1.5; }
  .osso-product-faq__question summary::-webkit-details-marker { display: none; }
  .osso-product-faq__toggle { display: flex; width: 18px; flex-shrink: 0; }
  .osso-product-faq__toggle svg { width: 100%; height: auto; }
  .osso-product-faq__question[open] .osso-product-faq__toggle { transform: rotate(45deg); }
  .osso-product-faq__answer { padding: 0 2rem 1.5rem 0; font-size: .9rem; line-height: 1.75; }
  .osso-product-faq__answer > :first-child { margin-top: 0; }
  .osso-product-faq__answer > :last-child { margin-bottom: 0; }
  .osso-product-faq a { color: inherit; }
  .osso-product-faq summary:focus-visible, .osso-product-faq a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 749px) { .osso-product-faq__layout { grid-template-columns: 1fr; gap: 2rem; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Ossomosso - Product FAQ",
  "tag": "section",
  "class": "section section--full-width",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A few practical details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Answers to the questions that matter before you bring a piece home.</p>"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link text",
      "default": "Still have a question? Ask us."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f4f2ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#2a241f"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Ossomosso - Product FAQ"
    }
  ]
}
{% endschema %}
