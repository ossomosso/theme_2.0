    "ossomosso_product_faq": {
      "type": "ossomosso-product-faq",
      "settings": {
        "eyebrow": "Before you bring it home",
        "heading": "Questions about Organic.",
        "intro": "<p>The practical side of Organic: what is included, how to use it and how to care for it.</p>",
        "contact_label": "Still have a question? Talk to us.",
        "contact_url": "shopify://pages/contact",
        "background_color": "#f4f2ec",
        "text_color": "#2a241f"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Can I put water in Organic?",
            "answer": "<p>Organic is a decorative vase for dried flowers and branches. It is not designed to hold water: do not fill it directly or use it for fresh flowers in water.</p>",
            "open_by_default": false
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What is included with Organic?",
            "answer": "<p>One Organic vase. Flowers, branches and other styling props shown in the photographs are not included.</p>",
            "open_by_default": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I display Organic without flowers?",
            "answer": "<p>Yes. Its flowing outline is intended to work as a sculptural object on its own. A few dried branches can add height while leaving the shape of the vase visible.</p>",
            "open_by_default": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for outdoor use?",
            "answer": "<p>This piece is intended for indoor use. Keep it away from rain, direct heat and prolonged direct sunlight.</p>",
            "open_by_default": false
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How do I clean Organic?",
            "answer": "<p>Organic is 3D printed in PLA. Remove dust gently with a soft, dry cloth. Do not immerse it in water, put it in the dishwasher or use abrasive cleaners. Keep it away from direct heat.</p>",
            "open_by_default": false
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Why can I see fine lines on the surface?",
            "answer": "<p>3D printing builds each piece layer by layer. The fine lines are part of that process and give the surface its characteristic texture; small differences between pieces are normal.</p>",
            "open_by_default": false
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Each piece is made to order in Madrid. Preparation time and transit time are separate. See our <a href=\"/en/policies/shipping-policy\">shipping policy</a> for current delivery estimates and rates. Contact us before ordering if you need it for a particular date.</p>",
            "open_by_default": false
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Can I return Organic?",
            "answer": "<p>You have 90 days from delivery to request a return. Check the item’s eligibility, required condition and any exceptions in our <a href=\"/en/policies/refund-policy\">returns policy</a>. Email ossomosso.design@gmail.com before sending anything back.</p>",
            "open_by_default": false
          }
        }
      },
