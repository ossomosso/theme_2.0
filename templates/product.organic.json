    "ossomosso_product_story_en": {
      "type": "ossomosso-product-story",
      "blocks": {
        "details_mzHy3T": {
          "type": "details",
          "settings": {
            "eyebrow": "The idea behind Organic",
            "title": "A freer line for everyday spaces.",
            "text": "<p>Organic adds movement without needing a full bouquet. Display it on its own, or use a few dried branches that leave its flowing outline visible.</p>",
            "show_accordion": false,
            "accordion_1_heading": "Product details",
            "accordion_1_content": "<p>Decorative vase for dried flowers and branches, or display on its own. Do not fill directly with water.</p>",
            "accordion_2_heading": "Material and care",
            "accordion_2_content": "<p>3D printed in PLA in Madrid. Wipe with a soft, dry cloth. Keep away from direct heat and abrasive cleaners.</p>",
            "accordion_3_heading": "Shipping and returns",
            "accordion_3_content": "<p>Made to order in Madrid. Check our <a href=\"/en/policies/shipping-policy\">shipping policy</a> for production and delivery information, and our <a href=\"/en/policies/refund-policy\">returns policy</a> for return conditions. <a href=\"/en/pages/contact\">Contact us</a> if you need a specific date.</p>",
            "media_position": "left"
          }
        },
        "tech_specs_cMwUTM": {
          "type": "tech_specs",
          "settings": {
            "label": "The piece in detail",
