          "type": "reviews",
          "settings": {
            "label": "Styling and care",
            "title": "Living with Organic",
            "rating_text": "",
            "review_1_author": "Branches",
            "review_1_text": "Choose a few asymmetrical dried branches to echo the movement of Organic.",
            "review_2_author": "On its own",
            "review_2_text": "Leave the vase empty on a shelf to make its sculptural outline the focus.",
            "review_3_author": "Care",
            "review_3_text": "Wipe Organic with a soft, dry cloth. Keep away from heat sources and avoid abrasive cleaners."
          },
          "disabled": true
