          }
        },
        "details_mzHy3T": {
          "type": "details",
          "settings": {
            "eyebrow": "The idea behind Japandi",
            "title": "A balance between natural and precise.",
            "text": "<p>Japandi takes the warmth of an organic vessel and pares it back until the shape feels clear, useful and easy to live with.</p>",
            "show_accordion": true,
            "accordion_1_heading": "Product details",
            "accordion_1_content": "<p>Decorative vase for dried flowers, branches or display on its own. Not intended for direct water use.</p>",
            "accordion_2_heading": "Materials and process",
            "accordion_2_content": "<p>Printed in biodegradable PLA in small batches and finished in Madrid.</p>",
            "accordion_3_heading": "Shipping and returns",
            "accordion_3_content": "<p>Made to order. We are happy to help with delivery questions or returns.</p>"
          }
