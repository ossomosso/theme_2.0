          "settings": {
            "feature_1_title": "A soft profile",
            "feature_1_text": "The silhouette keeps its curves gentle, creating a relaxed presence on a shelf or table.",
            "feature_2_title": "Made for calm spaces",
            "feature_2_text": "Japandi sits naturally with tactile, neutral materials and uncluttered rooms.",
            "feature_3_title": "A tactile finish",
            "feature_3_text": "The printed layers add depth without disturbing the simplicity of the form.",
            "feature_4_title": "Easy to restyle",
            "feature_4_text": "Move it from a console to a bedside table as the season or arrangement changes."
          }
        },
        "media_grid_yiBkYA": {
