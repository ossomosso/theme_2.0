        "intro_ihcmLB": {
          "type": "intro",
          "disabled": true,
          "settings": {
            "eyebrow": "Quietly tactile",
            "title": "A vase for slower compositions",
            "body": "<p>Japandi pairs a soft, organic profile with the restraint of a quiet interior. It is made to sit comfortably among wood, linen, stone and light.</p>",
            "show_specs": true,
            "spec_1_label": "Character",
            "spec_1_value": "Soft and restrained",
            "spec_2_label": "Production",
