          "type": "intro",
          "disabled": true,
          "settings": {
            "eyebrow": "Lightness in motion",
            "title": "A quiet breeze captured in form",
            "body": "<p>Brisa is a compact lamp with a fluid silhouette and an easy presence. It brings a gentle glow to desks, shelves and the spaces between.</p>",
            "show_specs": true,
            "spec_1_label": "Character",
            "spec_1_value": "Airy and rounded",
