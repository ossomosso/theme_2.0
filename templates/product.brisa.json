          "settings": {
            "feature_1_title": "Fluid geometry",
            "feature_1_text": "Rounded lines give Brisa a sense of movement without making it visually loud.",
            "feature_2_title": "A small footprint",
            "feature_2_text": "Its compact scale works well on shelves, bedside tables and smaller surfaces.",
            "feature_3_title": "Colour with restraint",
            "feature_3_text": "Choose the tone that fits your room while keeping the silhouette quietly expressive.",
            "feature_4_title": "Printed when ordered",
            "feature_4_text": "We make each lamp in small batches, only when it has a home to go to."
          }
        },
