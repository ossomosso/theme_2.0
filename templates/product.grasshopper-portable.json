        "question_2": {
          "type": "question",
          "settings": {
            "open_by_default": false,
            "question": "How do I charge it?",
            "answer": "<p>Connect a USB-C cable to the charging port on the lamp.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "open_by_default": false,
            "question": "Where can I use it?",
            "answer": "<p>It is intended for indoor use. Try it on a bedside table, a console or a shelf as a point of ambient light.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "open_by_default": false,
            "question": "How do I clean it?",
            "answer": "<p>Turn the lamp off, disconnect it from charging and wipe it with a soft, dry cloth. Keep it away from water and abrasive cleaners.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "open_by_default": false,
            "question": "Can I return it?",
            "answer": "<p>You have 90 days from delivery to request a return. Check our <a href=\"/en/policies/refund-policy\">returns policy</a> for conditions, or email <a href=\"mailto:info@ossomosso.com\">info@ossomosso.com</a>.</p>"
          }
        }
