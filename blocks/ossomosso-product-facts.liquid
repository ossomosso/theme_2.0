<div class="osso-product-facts" {{ block.shopify_attributes }}>
  <ul class="osso-product-facts__list" role="list">
    {% for i in (1..4) %}
      {% liquid
        assign title_key = 'title_' | append: i
        assign text_key = 'text_' | append: i
        assign icon_key = 'icon_' | append: i
      %}
      {% if block.settings[title_key] != blank %}
        <li class="osso-product-facts__item">
          {% render 'icon-or-image', icon: block.settings[icon_key], image_upload: nil, width: 24, class_name: 'osso-product-facts__icon' %}
          <div><strong>{{ block.settings[title_key] | escape }}</strong><span>{{ block.settings[text_key] | escape }}</span></div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
  {% if block.settings.faq_label != blank %}
    <a class="osso-product-facts__link" href="#OssomossoProductFAQ">{{ block.settings.faq_label | escape }} <span aria-hidden="true">↗</span></a>
  {% endif %}
</div>
{% stylesheet %}
  .osso-product-facts { width: 100%; padding-block: 1rem; border-block: 1px solid rgb(var(--color-foreground-rgb) / .15); }
  .osso-product-facts__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1rem; }
  .osso-product-facts__item { display: flex; gap: .7rem; align-items: flex-start; min-width: 0; }
  .osso-product-facts__icon { flex: 0 0 24px; fill: currentColor; }
  .osso-product-facts__item strong { display: block; font-size: .82rem; font-weight: 500; line-height: 1.4; }
  .osso-product-facts__item span { display: block; font-size: .75rem; line-height: 1.5; opacity: .7; margin-top: .2rem; }
  .osso-product-facts__link { display: inline-flex; gap: .5rem; margin-top: 1.25rem; text-underline-offset: .25em; font-size: .8rem; }
  .osso-product-facts__link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 359px) { .osso-product-facts__list { grid-template-columns: 1fr; } }
{% endstylesheet %}
