{% doc %}
  Native Shopify project enquiry, with a distinct id and request type per audience.
  @param {string} audience - private or corporate
  @param {string} section_id - Section identifier for unique field and form ids
{% enddoc %}
{% liquid
  assign form_id = 'Project-' | append: audience | append: '-' | append: section_id
  assign heading_key = 'ossomosso_custom.' | append: audience | append: '_form_title'
  assign send_key = 'ossomosso_custom.' | append: audience | append: '_send'
%}
<div class="osso-custom__form-card">
  <h3>{{ heading_key | t }}</h3>
  <p class="osso-custom__form-intro">{{ 'ossomosso_custom.form_intro' | t }}</p>
  {% form 'contact', id: form_id, class: 'osso-custom__form' %}
    <input type="hidden" name="contact[id]" value="{{ form_id }}">
    <input type="hidden" name="contact[Request type]" value="{% if audience == 'corporate' %}Corporate gifting{% else %}Private customization{% endif %}">
    {% if form.posted_successfully? and form.id == form_id %}<p class="osso-custom__success" role="status" tabindex="-1" autofocus>{{ 'blocks.contact_form.post_success' | t }}</p>{% endif %}
    {% if form.errors and form.id == form_id %}<div id="{{ form_id }}-errors" class="osso-custom__error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>{% endif %}
    <div class="osso-custom__fields">
      <div><label for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }} *</label><input id="{{ form_id }}-name" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"></div>
      <div><label for="{{ form_id }}-email">{{ 'blocks.contact_form.email' | t }} *</label><input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" {% if form.errors contains 'email' and form.id == form_id %}aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}></div>
      {% if audience == 'corporate' %}
        <div class="osso-custom__wide"><label for="{{ form_id }}-company">{{ 'ossomosso_custom.company' | t }} *</label><input id="{{ form_id }}-company" name="contact[Company]" autocomplete="organization" required></div>
        <div><label for="{{ form_id }}-quantity">{{ 'ossomosso_custom.quantity' | t }}</label><input id="{{ form_id }}-quantity" type="number" name="contact[Approximate quantity]" min="1" step="1" inputmode="numeric"></div>
        <div><label for="{{ form_id }}-date">{{ 'ossomosso_custom.date' | t }}</label><input id="{{ form_id }}-date" type="date" name="contact[Preferred delivery date]"></div>
        <div class="osso-custom__wide"><label for="{{ form_id }}-budget">{{ 'ossomosso_custom.budget' | t }}</label><input id="{{ form_id }}-budget" name="contact[Indicative budget]"></div>
      {% else %}
        <div class="osso-custom__wide"><label for="{{ form_id }}-piece">{{ 'ossomosso_custom.piece' | t }}</label><input id="{{ form_id }}-piece" name="contact[Piece or model]"></div>
      {% endif %}
      <div class="osso-custom__wide"><label for="{{ form_id }}-message">{{ 'ossomosso_custom.message' | t }} *</label><textarea id="{{ form_id }}-message" name="contact[body]" rows="5" required aria-describedby="{{ form_id }}-hint">{{ form.body | escape }}</textarea><p id="{{ form_id }}-hint" class="osso-custom__hint">{% if audience == 'corporate' %}{{ 'ossomosso_custom.corporate_hint' | t }}{% else %}{{ 'ossomosso_custom.private_hint' | t }}{% endif %}</p></div>
    </div>
    <button type="submit" class="button osso-custom__submit" style="--osso-button-face:#d8c3a5;--osso-button-ink:#2a2420;">{{ send_key | t }}<span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></button>
    <p class="osso-custom__privacy">{{ 'ossomosso_custom.privacy' | t }} <a href="{{ shop.privacy_policy.url }}">{{ 'ossomosso_contact.privacy_link' | t }}</a>.</p>
  {% endform %}
</div>
