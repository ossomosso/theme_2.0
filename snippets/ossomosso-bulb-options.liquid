{%- if part == 'picker' and upgrade.available -%}
  {%- liquid
    assign heading = 'ossomosso_bulb.choose' | t
    assign white_label = 'ossomosso_bulb.white' | t
    assign white_note = 'ossomosso_bulb.included' | t
    assign rgb_label = 'ossomosso_bulb.rgb' | t
  -%}
  <fieldset class="osso-bulb-options">
    <legend>{{ options.bulb_heading | default: heading | escape }}</legend>
    <label>
      <input type="radio" name="osso_bulb" value="" checked>
      <span>{{ options.white_bulb_label | default: white_label | escape }}</span>
      <small>{{ options.white_bulb_note | default: white_note | escape }}</small>
    </label>
    <label>
      <input type="radio" name="osso_bulb" value="{{ upgrade.id }}">
      <span>{{ options.rgb_bulb_label | default: rgb_label | escape }}</span>
      <small>+{{ upgrade.price | money_without_currency }} €</small>
    </label>
  </fieldset>
{%- elsif part == 'portable' and portable != blank -%}
  {%- liquid
    assign heading = 'ossomosso_bulb.portable' | t
    assign link_label = 'ossomosso_bulb.view_portable' | t: title: portable.title
    assign card_image = options.portable_image | default: portable.featured_image
  -%}
  <a class="osso-portable-link" href="{{ portable.url }}">
    {%- if card_image -%}
      {{ card_image | image_url: width: 192, height: 192, crop: 'center' | image_tag: widths: '64, 128, 192', sizes: '64px', width: 64, height: 64, alt: '', loading: 'lazy' }}
    {%- endif -%}
    <span>
      <strong>{{ options.portable_heading | default: heading | escape }}</strong>
      <small>{{ options.portable_link_label | default: link_label | escape }}</small>
    </span>
    <span class="osso-portable-link__arrow" aria-hidden="true">↗</span>
  </a>
{%- endif -%}
